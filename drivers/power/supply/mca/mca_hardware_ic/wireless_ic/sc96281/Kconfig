config MCA_EXTERNAL_WIRELESS_SC96281
	tristate "Xiaomi SC96281 wireless receiver"
	depends on I2C && OF && GPIOLIB
	depends on XIAOMI_MCA_CLASSES && XIAOMI_MCA_STRATEGY_CLASS && XIAOMI_MCA_ADSP_PD
	select REGMAP_I2C
	help
	  SC96281 receiver using board dual Hall GPIOs and six-column FOD data.
	  Uses resident IC firmware; contains no firmware programming payload.
