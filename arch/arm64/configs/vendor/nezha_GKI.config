# Xiaomi 17 Ultra, on top of gki_defconfig and vendor/canoe_GKI.config.
CONFIG_TARGET_PRODUCT_NEZHA=y
# CONFIG_TARGET_PRODUCT_MYRON is not set
CONFIG_OF_OVERLAY=y

# The shared fragment also selects Myron board drivers. Nezha touch is external.
# CONFIG_MYRON_BQ_READONLY is not set
# CONFIG_MYRON_BUCK_THERMAL is not set
# CONFIG_MYRON_CHARGE_IC is not set
# CONFIG_MYRON_MCA_BASE is not set
# CONFIG_MYRON_MCA_COMPLETE_SERVICES is not set
# CONFIG_MYRON_MCA_INTERFACE is not set
# CONFIG_MYRON_MCA_PLATFORM is not set
# CONFIG_MYRON_MCA_READONLY is not set
# CONFIG_MYRON_MCA_SERVICES is not set
# CONFIG_MYRON_MISC is not set
# CONFIG_MYRON_TFA98XX is not set
# CONFIG_TOUCHSCREEN_FOCALTECH_MYRON is not set
# CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE is not set

# Shared charging framework and class interfaces.
CONFIG_XIAOMI_MCA_CORE=m
CONFIG_XIAOMI_MCA_STRATEGY_CLASS=m
CONFIG_XIAOMI_MCA_NEZHA_FG_PSY=m
CONFIG_XIAOMI_MCA_CLASSES=m
CONFIG_XIAOMI_MCA_SC8581=m
CONFIG_MCA_QCOM_PANEL=m
CONFIG_XIAOMI_MCA_ADSP_PD=m
CONFIG_XIAOMI_MCA_NEZHA_SUBPMIC=m

# Main battery telemetry on QUP SE5.
CONFIG_BATTERY_BQ27XXX=m
CONFIG_BATTERY_BQ27XXX_I2C=m
# CONFIG_BATTERY_BQ27XXX_HDQ is not set
# CONFIG_BATTERY_BQ27XXX_DT_UPDATES_NVM is not set

# Satellite modem and its RF supplies.
# CONFIG_XIAOMI_DXS702 is not set
# CONFIG_REGULATOR_ET5907MV is not set
# CONFIG_REGULATOR_HL7603 is not set

CONFIG_INPUT_XIAOMI_FOCUS_RING=m
